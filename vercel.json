{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/centres/geojson",
      "destination": "/api/centres/geojson"
    },
    {
      "source": "/api/centres/:centre_id",
      "destination": "/api/centres/detail"
    },
    {
      "source": "/api/toronto/centres/:centre_id",
      "destination": "/api/toronto/locations/centres"
    },
    {
      "source": "/api/toronto/districts",
      "destination": "/api/toronto/locations/centres?resource=districts"
    },
    {
      "source": "/api/toronto/facility-types",
      "destination": "/api/toronto/locations/centres?resource=facility-types"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/toronto/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
