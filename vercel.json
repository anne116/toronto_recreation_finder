{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/centres/geojson",
      "destination": "/api/centres/geojson"
    },
    {
      "source": "/api/centres/:centre_id/programs",
      "destination": "/api/centres/programs"
    },
    {
      "source": "/api/centres/:centre_id/facilities",
      "destination": "/api/centres/facilities"
    },
    {
      "source": "/api/centres/:centre_id",
      "destination": "/api/centres/detail"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
